Algoritmo esctructura_simple
	//comparar el menor de 2 numeros reales
	Definir n1 , n2 Como Real;
	Escribir "Ingresar el primer numero:";
	leer n1;
	Escribir "Ingrese el segundo numero:";
	leer n2;
	//determinar el menor
	si n1 < n2 Entonces
		Escribir "El menor numero es: ",n1;
	FinSi
	si n2 < n1 Entonces
		Escribir "El menor es: ",n2;
	FinSi
FinAlgoritmo
